<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".Home_LandingPage.Workouts.WorkoutModule1"
    tools:ignore="HardcodedText"
    tools:layout_editor_absoluteX="13dp"
    tools:layout_editor_absoluteY="-1dp">


    <TextView
        android:id="@+id/workout_txt"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/konkhmer_sleokchher"
        android:text="Workouts"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/FEPAddWorkout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.142"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />


    <Button
        android:id="@+id/FEPAddWorkout"
        android:layout_width="329dp"
        android:layout_height="55dp"
        android:backgroundTint="#000000"
        android:includeFontPadding="false"
        android:paddingLeft="25dp"
        android:paddingRight="25dp"
        android:text="Add Workout"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        app:cornerRadius="20dp"
        app:icon="@drawable/plus_icon"
        app:iconTint="#DE612B"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.512"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.16"
        app:strokeColor="#DE612B"
        app:strokeWidth="1dp" />

    <TextView
        android:id="@+id/textView37"
        android:layout_width="wrap_content"
        android:layout_height="37dp"
        android:text="Get Started"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/textView38"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/FEPAddWorkout"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/textView38"
        android:layout_width="225dp"
        android:layout_height="49dp"
        android:text="Click “Add a workout” to start"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.318"
        app:lineHeight="13sp" />


    <TextView
        android:id="@+id/planWorkoutCounter_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:text="No workouts yet"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@+id/textView37"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="wrap_content"
        android:layout_height="570dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView37">


        <LinearLayout
            android:id="@+id/recommendations_layout"
            android:layout_width="380dp"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_blackgradient"
            android:orientation="vertical"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView37">


            <TextView
                android:id="@+id/textView41"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:text="Recommendations:"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <Button
                android:id="@+id/button2"
                android:layout_width="340dp"
                android:layout_height="90dp"
                android:layout_marginTop="2dp"
                android:layout_marginStart="20dp"
                android:backgroundTint="#000000"
                android:clickable="false"
                android:fontFamily="@font/konkhmer_sleokchher"
                android:includeFontPadding="false"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="0dp"
                android:paddingBottom="16dp"
                android:text="Lose Weight"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:icon="@drawable/lose_weight_bar_icon"
                app:iconTint="#DE612B"
                app:strokeColor="#DE612B"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/button3"
                android:layout_width="340dp"
                android:layout_height="90dp"
                android:layout_marginTop="2dp"
                android:layout_marginStart="20dp"
                android:backgroundTint="#000000"
                android:clickable="false"
                android:fontFamily="@font/konkhmer_sleokchher"
                android:includeFontPadding="false"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="0dp"
                android:paddingBottom="16dp"
                android:text="Fitness"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:icon="@drawable/functional_fitness"
                app:iconTint="#DE612B"
                app:strokeColor="#DE612B"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/button4"
                android:layout_width="340dp"
                android:layout_height="90dp"
                android:layout_marginTop="2dp"
                android:layout_marginStart="20dp"
                android:backgroundTint="#000000"
                android:clickable="false"
                android:fontFamily="@font/konkhmer_sleokchher"
                android:includeFontPadding="false"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="0dp"
                android:paddingBottom="16dp"
                android:text="Wellness and Reduce Stress"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:icon="@drawable/wellness_and_reduce_stress"
                app:iconTint="#DE612B"
                app:strokeColor="#DE612B"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/button5"
                android:layout_width="340dp"
                android:layout_height="90dp"
                android:layout_marginTop="2dp"
                android:layout_marginStart="20dp"
                android:backgroundTint="#000000"
                android:clickable="false"
                android:fontFamily="@font/konkhmer_sleokchher"
                android:includeFontPadding="false"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="0dp"
                android:paddingBottom="16dp"
                android:text="Mobility"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:icon="@drawable/mobility"
                app:iconTint="#DE612B"
                app:strokeColor="#DE612B"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/button10"
                android:layout_width="340dp"
                android:layout_height="90dp"
                android:layout_marginTop="2dp"
                android:layout_marginStart="20dp"
                android:backgroundTint="#000000"
                android:clickable="false"
                android:fontFamily="@font/konkhmer_sleokchher"
                android:includeFontPadding="false"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="0dp"
                android:paddingBottom="16dp"
                android:text="Build Muscle"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                android:textIsSelectable="false"
                app:cornerRadius="10dp"
                app:icon="@drawable/build_muscle"
                app:iconTint="#DE612B"
                app:strokeColor="#DE612B"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/button11"
                android:layout_width="340dp"
                android:layout_height="90dp"
                android:layout_marginTop="2dp"
                android:layout_marginStart="20dp"
                android:backgroundTint="#000000"
                android:clickable="false"
                android:fontFamily="@font/konkhmer_sleokchher"
                android:includeFontPadding="false"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="0dp"
                android:paddingBottom="16dp"
                android:text="Increase Strength"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_increase_strength"
                app:iconTint="#DE612B"
                app:strokeColor="#DE612B"
                app:strokeWidth="1dp" />


        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/addItemBtn"
        android:layout_width="33dp"
        android:layout_height="33dp"
        android:layout_gravity="end"
        android:background="@null"
        android:src="@drawable/additem"
        android:visibility="gone"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="2dp"
        tools:layout_editor_absoluteY="-1dp" />
</androidx.constraintlayout.widget.ConstraintLayout>