<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coders"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="16dp"
    tools:context=".Home_LandingPage.Settings.SettingsFragment">

    <!-- Header -->
    <TextView
        android:id="@+id/tracker_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tracker"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tracker_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Back"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- Add Schedule Button -->
    <ScrollView
        android:layout_width="382dp"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <Button
            android:id="@+id/btn_add_schedule"
            android:layout_width="350dp"
            android:layout_height="65dp"
            android:layout_marginTop="48dp"
            android:backgroundTint="@color/custom_orange"
            android:text="+ Add Schedule"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="25sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.482"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tracker_title" />

        <ImageView
            android:id="@+id/iv_empty_schedule_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="52dp"
            android:src="@drawable/ic_schedule"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_add_schedule" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/schedule_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:background="@drawable/bg_blackgradient"
            android:elevation="10dp"
            android:padding="16dp"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tracker_title">

            <!-- Circular ProgressBar -->

            <!-- Set the Days Text -->
            <me.zhanghai.android.materialprogressbar.MaterialProgressBar
                android:id="@+id/circular_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                app:layout_constraintEnd_toStartOf="@+id/goal_container"
                app:layout_constraintHorizontal_bias="0.18"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_goals"
                app:mpb_progressStyle="circular"
                app:mpb_progressTint="@color/custom_orange" />


            <TextView
                android:id="@+id/tv_set_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set the Days"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Save Button -->
            <TextView
                android:id="@+id/tv_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_set_days" />

            <!-- Days Row (Mon to Sun) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_days"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_set_days">

                <!-- Sunday -->
                <Button
                    android:id="@+id/tv_sunday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/day_background"
                    android:fontFamily="@font/konkhmer_sleokchher"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:padding="0dp"
                    android:text="S"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toStartOf="@+id/tv_monday"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_percent="0.14" />

                <!-- Monday -->
                <Button
                    android:id="@+id/tv_monday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/day_background"
                    android:fontFamily="@font/konkhmer_sleokchher"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:padding="0dp"
                    android:text="M"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toStartOf="@+id/tv_tuesday"
                    app:layout_constraintStart_toEndOf="@+id/tv_sunday"
                    app:layout_constraintWidth_percent="0.14" />

                <!-- Tuesday -->
                <Button
                    android:id="@+id/tv_tuesday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/day_background"
                    android:fontFamily="@font/konkhmer_sleokchher"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:padding="0dp"
                    android:text="T"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toStartOf="@+id/tv_wednesday"
                    app:layout_constraintStart_toEndOf="@+id/tv_monday"
                    app:layout_constraintWidth_percent="0.14" />

                <!-- Wednesday -->
                <Button
                    android:id="@+id/tv_wednesday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/day_background"
                    android:fontFamily="@font/konkhmer_sleokchher"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:padding="0dp"
                    android:text="W"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toStartOf="@+id/tv_thursday"
                    app:layout_constraintStart_toEndOf="@+id/tv_tuesday"
                    app:layout_constraintWidth_percent="0.14" />

                <!-- Thursday -->
                <Button
                    android:id="@+id/tv_thursday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/day_background"
                    android:fontFamily="@font/konkhmer_sleokchher"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:padding="0dp"
                    android:text="T"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toStartOf="@+id/tv_friday"
                    app:layout_constraintStart_toEndOf="@+id/tv_wednesday"
                    app:layout_constraintWidth_percent="0.14" />

                <!-- Friday -->
                <Button
                    android:id="@+id/tv_friday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/day_background"
                    android:fontFamily="@font/konkhmer_sleokchher"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:padding="0dp"
                    android:text="F"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toStartOf="@+id/tv_saturday"
                    app:layout_constraintStart_toEndOf="@+id/tv_thursday"
                    app:layout_constraintWidth_percent="0.14" />

                <!-- Saturday -->
                <Button
                    android:id="@+id/tv_saturday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/day_background"
                    android:fontFamily="@font/konkhmer_sleokchher"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:padding="0dp"
                    android:text="S"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_friday"
                    app:layout_constraintWidth_percent="0.14" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- Goals Label -->
            <TextView
                android:id="@+id/tv_goals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Goals"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_days" />

            <!-- Goal 1 -->
            <LinearLayout
                android:id="@+id/goal_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_goals">


            </LinearLayout>

            <Button
                android:id="@+id/btn_add_goal"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_background"
                android:backgroundTint="@color/custom_orange"
                android:text="Add"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/goal_container" />

            <Button
                android:id="@+id/btn_add_workout"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_background"
                android:backgroundTint="@color/custom_orange"
                android:text="Select Workout"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="25sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.497"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/workout_container" />

            <LinearLayout
                android:id="@+id/workout_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="26dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_add_goal">

                <TextView
                    android:id="@+id/workoutTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Workout Title"
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/exerciseCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Exercise Count"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_view_workout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/custom_orange"
                    android:text="View Workout"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="25sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_add_workout" />


            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_empty_schedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="You need to set your Schedule this week"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.508"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_empty_schedule_icon" />


        <!-- ScrollView wrapping the History Section -->

        <ScrollView
            android:id="@+id/scrollView6"
            android:layout_width="0dp"
            android:layout_height="210dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_history_label"
            app:layout_constraintVertical_bias="0.0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- History Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/history_card_last_week"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_blackgradient"
                    android:padding="12dp">


                    <TextView
                        android:id="@+id/tv_last_week"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Week"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/week_days_row"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_last_week">

                        <!-- Example of week days -->
                        <TextView
                            android:id="@+id/his_monday"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/day_background"
                            android:backgroundTint="@color/custom_orange"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="M"
                            android:textColor="@color/black"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintWidth_percent="0.14" />

                        <!-- Add other days similarly -->
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Completion Status -->
                    <TextView
                        android:id="@+id/tv_goal_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="You completed your goal this week"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/week_days_row" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <Button
                    android:id="@+id/btn_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Reset"
                    app:cornerRadius="25dp" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/tv_history_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="History"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/schedule_container"
            app:layout_constraintVertical_bias="0.073" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <!-- Placeholder for Schedule -->

    <!-- History Section -->
    <!-- Schedule Container (Initially Hidden) -->
    <!-- History Card Example -->


</androidx.constraintlayout.widget.ConstraintLayout>
