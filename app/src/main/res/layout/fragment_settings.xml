<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".Home_LandingPage.Settings.SettingsFragment"
    tools:ignore="HardcodedText">

    <!-- TODO: Update blank fragment layout -->


    <TextView
        android:id="@+id/bugtxt"
        android:layout_width="92dp"
        android:layout_height="19dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/konkhmer_sleokchher"
        android:gravity="center"
        android:text="@string/BUG"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/textView36"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.96" />

    <Button
        android:id="@+id/Settings_LogoutButton"
        android:layout_width="357dp"
        android:layout_height="55dp"
        android:text="Log out"
        android:textAllCaps="false"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toTopOf="@+id/bugtxt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/Delete_account"
        android:layout_width="357dp"
        android:layout_height="58dp"
        android:backgroundTint="#000000"
        android:text="Delete Account"
        android:textAlignment="textStart"
        android:textAllCaps="false"
        android:textColor="@color/custom_orange"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toTopOf="@+id/Settings_LogoutButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.931"
        app:strokeColor="#DE612B"
        app:strokeWidth="1dp" />

    <LinearLayout
        android:id="@+id/linearLayout8"
        android:layout_width="357dp"
        android:layout_height="200dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/Delete_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.821">

        <TextView
            android:id="@+id/textapp"
            android:layout_width="122dp"
            android:layout_height="30dp"
            android:layout_marginStart="15dp"
            android:fontFamily="@font/konkhmer_sleokchher"
            android:text="Application"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/Settings_Help_Center"
            android:layout_width="357dp"
            android:layout_height="58dp"
            android:backgroundTint="#000000"
            android:drawableEnd="@drawable/right_arrow_icon"
            android:text="Help Center"
            android:textAlignment="textStart"
            android:textAllCaps="false"
            app:cornerRadius="20dp"
            app:strokeColor="#DE612B"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/Settings_Licenses"
            android:layout_width="357dp"
            android:layout_height="58dp"
            android:backgroundTint="#000000"
            android:drawableEnd="@drawable/right_arrow_icon"
            android:text="Licenses"
            android:textAlignment="textStart"
            android:textAllCaps="false"
            app:cornerRadius="20dp"
            app:strokeColor="#DE612B"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/Settings_Notifications"
            android:layout_width="357dp"
            android:layout_height="58dp"
            android:backgroundTint="#000000"
            android:drawableEnd="@drawable/right_arrow_icon"
            android:text="Notification"
            android:textAlignment="textStart"
            android:textAllCaps="false"
            app:cornerRadius="20dp"
            app:strokeColor="#DE612B"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textView36"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineHeight="10sp"
        android:text="@string/HeavyMetals"
        android:textColor="@color/white"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.991" />

    <LinearLayout
        android:layout_width="357dp"
        android:layout_height="200dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.727">

        <TextView
            android:id="@+id/accountxt"
            android:layout_width="92dp"
            android:layout_height="30dp"
            android:layout_marginStart="15dp"
            android:fontFamily="@font/konkhmer_sleokchher"
            android:text="Account"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/Settings_Profile"
            android:layout_width="357dp"
            android:layout_height="58dp"
            android:backgroundTint="#000000"
            android:drawableEnd="@drawable/right_arrow_icon"
            android:text="Profile"
            android:textAlignment="textStart"
            android:textAllCaps="false"
            app:cornerRadius="20dp"
            app:strokeColor="#DE612B"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/Settings_Goals"
            android:layout_width="357dp"
            android:layout_height="58dp"
            android:backgroundTint="#000000"
            android:drawableEnd="@drawable/right_arrow_icon"
            android:text="Goals"
            android:textAlignment="textStart"
            android:textAllCaps="false"
            app:cornerRadius="20dp"
            app:strokeColor="#DE612B"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/Settings_Measurements"
            android:layout_width="357dp"
            android:layout_height="58dp"
            android:backgroundTint="#000000"
            android:drawableEnd="@drawable/right_arrow_icon"
            android:text="Measurement"
            android:textAlignment="textStart"
            android:textAllCaps="false"
            app:cornerRadius="20dp"
            app:strokeColor="#DE612B"
            app:strokeWidth="1dp" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>